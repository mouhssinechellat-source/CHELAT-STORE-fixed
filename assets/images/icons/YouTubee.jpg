87,63]]}]], sideChannel: {}});</script><script class="ds:8" nonce="Ls5Id0IgxDU1YE_CDUd5Xw">AF_initDataCallback({key: 'ds:8', hash: '23', data:[null,[null,[[{"4":["qgJXElUQAKIBEwiOv7C5pIWYAxVo5EQHHbkhFN+6CToKNgowYXBwc19kZXRhaWxzX2xpdmVfb3BzX2NvbS5nb29nbGUuYW5kcm9pZC55b3V0dWJlEC0YAyAC"],"53":[[[[["com.google.android.youtube",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/QNmuZQc9I6Zbe3mWnSr0hycnENqGFCI5p3yE29Hkxtf22T0IWS6zTrpxULLyyjWpB7ONAXDsDQXnXcVWokl3eg"],null,[255,255,255,255],null,null,null,2],[[null,2,[2160,1080],[null,null,"https://play-lh.googleusercontent.com/nf-qXMZ18VbtggOGKdW7f11us__ZS8aqi2KBBIOpnA6deqBwaIeky8nUcb13sPCWRVLuMzCnDS-ZeOy2BSZM"]],[null,2,[2160,1080],[null,null,"https://play-lh.googleusercontent.com/X8DOqSz4FInZehjRq-POn_OKg6x_E4d0to1hCu9svzboASPNvWnRLdyYAq07tk6O8eCX2hPqZMDtxGooRHe2"]],[null,2,[2160,1080],[null,null,"https://play-lh.googleusercontent.com/uAVB8gcU92pSg-MYGRDfSoQmP5cS9OgLp8bNAo_I7Jl-AsaGDjA182JgwH-HZIH6lSJtP6qsST9g-2y5kIj28w"]],[null,2,[2160,1080],[null,null,"https://play-lh.googleusercontent.com/gI2iDgkiGtnBgHEU2q7MoTzhOOytnb8rRD1XS11RI2lcwB46_rzpHY_xFHhBan9w1EbCNatWll1qDIuttPXI"]],[null,2,[2160,1080],[null,null,"https://play-lh.googleusercontent.com/pwpFVQTXtPmnAJ7_OGzgzAle8-xIDq-v3n8NPDiZE3YA93ZA58t6fvYd60R_Fv1SZQDxjURhPf0tJqYSSAOFAA"]]],"YouTube",["3,7",3.7438629],"Lecteurs et éditeurs vidéo",null,null,[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.google.android.youtube\u0026rdid\u003dcom.google.android.youtube\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[[null,1]],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.google.android.youtube"]],["CCGqAnoaeAgAShMIjr+wuaSFmAMVaOREBx25IRTfsgReCloKIAoaY29tLmdvb2dsZS5hbmRyb2lkLnlvdXR1YmUQARgDEhkKEzQ4Mjk5MTQ4NTAwNzM2NjQ4OTUQURgDGAMgAiiA4q3PljQwgLGryJ80QAFIAVoCCAGAAQMwEA\u003d\u003d"],[[[null,null,"__NeP0RqACU",[null,null,"https://play.google.com/video/lava/web/player/yt:movie:__NeP0RqACU?autoplay\u003d1\u0026authuser\u003d0\u0026embed\u003dplay"],"yt:movie:__NeP0RqACU",null,null,null,null,"AXH1eznLkTOtlpc5ddDMj-itLFnMo9XzM30-ZF8thuCpdBofHYszav_FwMv_P55WD3Ammgc2jjnTTF6XCOUrp7i0KD4Ivk-8csyhPHrH1sXXtbWH8fnh_W-74Zg_Svfz0SiQn40ye1cHlmnlyVJHWExgDsjwlJ56NzLA-4FOaRcFcK7_pfLNf5NCFrJSvYAabeFKKtIp_J43v-Db2oXcMr9Qajl-x4fdy2VDaBTJi7a_P5IeBug1ev24k1ucO7a4BxlwwDv18Vf5c168CDzLIjSHSrp9ZeHuxPus5ZaYe6CJpQYB"],null,1,[null,null,null,[null,null,"https://i.ytimg.com/vi/__NeP0RqACU/hqdefault.jpg"]]]],[null,"Téléchargez l\u0026#39;application YouTube officielle sur votre téléphone ou tablette Android. Découvrez les contenus regardés partout dans le monde : des clips musicaux du moment aux vidéos populaires sur les jeux vidéo, la mode, la beauté, les actualités, l\u0026#39;éducation et bien plus encore. Abonnez-vous aux chaînes que vous aimez, créez vos propres vidéos, partagez des contenus avec vos amis et profitez de YouTube sur n\u0026#39;importe quel appareil.\u003cbr\u003e\u003cbr\u003eRegardez des vidéos et abonnez-vous à des chaînes \u003cbr\u003e● Explorez les recommandations personnalisées dans \u0026quot;Accueil\u0026quot;.\u003cbr\u003e● Découvrez les nouveautés de vos chaînes préférées dans \u0026quot;Abonnements\u0026quot;. \u003cbr\u003e● Retrouvez les vidéos que vous avez regardées, aimées et enregistrées pour plus tard dans \u0026quot;Bibliothèque\u0026quot;. \u003cbr\u003e\u003cbr\u003eExplorez des sujets variés, des contenus populaires et nos sélections à découvrir (disponibles dans certains pays)\u003cbr\u003e● Ne manquez aucune vidéo populaire sur les jeux vidéo, la beauté, les actualités, l\u0026#39;éducation et bien plus encore.\u003cbr\u003e● Découvrez les tendances sur YouTube et à travers le monde dans \u0026quot;Explorer\u0026quot;.\u003cbr\u003e● Parcourez nos sélections de créateurs, gamers et artistes à découvrir (disponibles dans certains pays).\u003cbr\u003e\u003cbr\u003eRejoignez la communauté YouTube\u003cbr\u003e● Suivez vos créateurs favoris via les posts, les stories, les Premières et les diffusions en direct.\u003cbr\u003e● Participez à la discussion dans les commentaires, et interagissez avec les créateurs et les autres membres de la communauté.\u003cbr\u003e\u003cbr\u003eCréez des contenus sur votre appareil mobile\u003cbr\u003e● Créez ou importez vos propres vidéos directement dans l\u0026#39;application. \u003cbr\u003e● Interagissez avec votre audience en temps réel avec le streaming en direct depuis l\u0026#39;application.\u003cbr\u003e\u003cbr\u003eChoisissez l\u0026#39;expérience adaptée à vos besoins et ceux de votre famille (disponible dans certains pays)\u003cbr\u003e● L’encadrement de l\u0026#39;accès aux vidéos en ligne varie d\u0026#39;une famille à l\u0026#39;autre. Découvrez les options que nous vous proposons : l\u0026#39;application YouTube Kids et la nouvelle expérience supervisée par les parents sur YouTube (youtube.com/myfamily).\u003cbr\u003e\u003cbr\u003eSoutenez les créateurs que vous aimez avec les souscriptions aux chaînes (disponibles dans certains pays)\u003cbr\u003e● Rejoignez les chaînes qui proposent une souscription mensuelle payante pour leur manifester votre soutien.\u003cbr\u003e● Accédez aux avantages exclusifs offerts par des chaînes et devenez membre de leur communauté.\u003cbr\u003e● Démarquez-vous des autres spectateurs dans les commentaires et le chat en direct grâce à l\u0026#39;affichage d\u0026#39;un badge de fidélité à côté de votre nom d\u0026#39;utilisateur.\u003cbr\u003e\u003cbr\u003ePassez à YouTube Premium (disponible dans certains pays)\u003cbr\u003e● Regardez des vidéos sans publicité tout en utilisant d\u0026#39;autres applications ou avec l\u0026#39;écran verrouillé.\u003cbr\u003e● Enregistrez des vidéos pour les regarder quand vous voulez, par exemple dans l\u0026#39;avion ou les transports.\u003cbr\u003e● Profitez de YouTube Music Premium dans le cadre de vos avantages."],"Google LLC","10 000 000 000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/_FjKDuJDbhlGIZN7h5rcVY3NfyP8PZATgR-0MKiYz8DeKofTecT57LU-TTlAGiX07vDBIaXDcZiafhHFU4pI1w"],null,[54,54,54,255]],null,["Accord parental",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/VI5ii6OTeBuSn1kTDPlXSwj7yI7kqDqf_drsvZ90qjcm7LbbVkG8UfPTicKqMzipsY_lBnAYAH5t8GxN"]],[null,"Accord parental recommandé"],[null,"Interactivité des utilisateurs, Achats in-app"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026amp;hl\u003dfr\"\u003eEn savoir plus\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/QMII6a27D3wNv5lBrfnnDgZK1DhX9XW8-ZaE68dzoNjMPdpnQLWzKhnznb7YzsO5bvTfntpj8i-q8M94"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026hl\u003dfr"]]],[[[[[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.google.android.youtube\u0026rdid\u003dcom.google.android.youtube\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Installer"],null,["CgYKBENBRT0\u003d"]]]],[2],[2],[1,1,0],["0,05 £GB - 810,00 £GB si facturé via Play",[0]],null,null,null,null,[2,0]],[[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.google.android.youtube"]],["CCGqAnoaeAgAShMIjr+wuaSFmAMVaOREBx25IRTfsgReCloKIAoaY29tLmdvb2dsZS5hbmRyb2lkLnlvdXR1YmUQARgDEhkKEzQ4Mjk5MTQ4NTAwNzM2NjQ4OTUQURgDGAMgAiiA4q3PljQwgLGryJ80QAFIAVoCCAGAAQMwEA\u003d\u003d"],[[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.google.android.youtube\u0026rdid\u003dcom.google.android.youtube\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]]],[null,"Tout découvrir sur L