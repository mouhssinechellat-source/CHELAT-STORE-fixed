1080],[null,null,"https://play-lh.googleusercontent.com/47OUgJ_404R126Eh-NiSLDCwg-9AjVzDRWfIRyuvvZlS6UzxlX7QEMLKAP9Qy17IAT3CBGFPqJ0wHJQxHa6fXQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/4q-OO_OVYpKl4Bp5I17DQKw4pItLk7sRK_taVMMlcWljxe14xYtqbypFe7ju0cpg99vu59cQ6AvmqfwLYtmv"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/912KofvyvAwMn4_L6Tsnk8oTg1jOgxJTegppPm-lXe1bhPeeCiLzxBKkMokJZ2dpn_5_aWQWucJXKbd6pUBTEA"]]],"ChatGPT",["4,7",4.735915],"Productivité",null,null,[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.openai.chatgpt\u0026rdid\u003dcom.openai.chatgpt\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[[null,1]],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.openai.chatgpt"]],["qgJ5GncIABIaChgKEmNvbS5vcGVuYWkuY2hhdGdwdBABGANKEwiZ0bG5pIWYAxVK4UQHHfm7E6OaARMImdGxuaSFmAMVSuFEBx35uxOj+gErCg0IABIJCgVmci1GUhAAEhoSBAgCEAEY8NH4+p+IjYhoIJ3hu/yt2uuifg\u003d\u003d"],null,[null,"Lancement de ChatGPT : les dernières innovations d’OpenAI à portée de main.\u003cbr\u003e\u003cbr\u003eCette appli officielle est gratuite, synchronise votre historique sur tous les appareils et met à votre disposition les dernières améliorations apportées aux modèles par OpenAI.\u003cbr\u003e\u003cbr\u003eChatGPT vous offre :\u003cbr\u003e\u003cbr\u003e· Le mode vocal : appuyez sur l’icône des écouteurs pour parler en marchant ou au volant, lancer une histoire au moment du coucher de vos enfants ou obtenir la réponse à une question soulevée lors d’un repas en famille ou entre amis\u003cbr\u003e· Des idées - pour choisir un cadeau d’anniversaire ou rédiger une carte de vœux personnalisée\u003cbr\u003e· Des conseils sur mesure - pour rédiger une réponse personnalisée ou communiquer dans une situation complexe\u003cbr\u003e· Des opportunités d\u0026#39;apprentissage - des éléments aussi bien pour expliquer l’électricité à un enfant passionné par les dinosaures que se remémorer les détails d’un événement historique\u003cbr\u003e· Une aide professionnelle - un partenaire pour l’élaboration d’un contenu marketing ou d’un business plan\u003cbr\u003e· Des réponses instantanées - pour savoir si la serviette doit être placée à droite ou à gauche de l’assiette ou créer un plat à partir de quelques ingrédients\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eRejoignez nos centaines de millions d’utilisateurs et essayez l’appli qui fascine le monde entier. Téléchargez ChatGPT dès maintenant.\u003cbr\u003e\u003cbr\u003eConditions d’utilisation \u0026amp; Politique de confidentialité :\u003cbr\u003ehttps://openai.com/policies/terms-of-use\u003cbr\u003ehttps://openai.com/policies/privacy-policy"],"OpenAI","1 000 000 000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/Os8SgmLAQPG8uQGICuoTowt4tAJTjBhYmcB_1_HvxcKmGAgB51XMdX7vtCNR8LKJmEG9bWX91d3b9ZvMzLia"],null,[60,70,255,255]],null,["Accord parental",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/VI5ii6OTeBuSn1kTDPlXSwj7yI7kqDqf_drsvZ90qjcm7LbbVkG8UfPTicKqMzipsY_lBnAYAH5t8GxN"]],[null,"Accord parental recommandé"],[null,"Achats in-app"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026amp;hl\u003dfr\"\u003eEn savoir plus\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/QMII6a27D3wNv5lBrfnnDgZK1DhX9XW8-ZaE68dzoNjMPdpnQLWzKhnznb7YzsO5bvTfntpj8i-q8M94"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026hl\u003dfr"]]],[[[[[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.openai.chatgpt\u0026rdid\u003dcom.openai.chatgpt\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Installer"],null,["CgYKBENBRT0\u003d"]]]],[2],[2],[1,1,0],["6,99 £GB - 444,99 £GB si facturé via Play",[0]],null,null,null,null,[2,0]],[["com.anthropic.claude",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/YeFCFSW5LkBVdsEAL_fjzxDxTbhKz31j1uZUfDbSaCeM0t4Bi3SqyHTWzWsUsZnbwjofXhYajitG_gr2_B2xil8"],null,[219,111,77,255],null,null,null,2],[[null,2,[2104,1184],[null,null,"https://play-lh.googleusercontent.com/8KkJh8r1-IZYb4kB4yEHCDhf8Kp6eaFdPFBeWY7R1tEs8toWkhvf9QGiiXP9zziB-KUvnuxyLwdBfRjc8uFw-sA"]],[null,2,[2104,1184],[null,null,"https://play-lh.googleusercontent.com/qw5XGXY9ajYFuz9N64HHSlT0xAc3vRCkhoxIKIzGkZ448yAikF5AP0mKD9bYRURHbwP3s9Ixp_IcOSPS4RAK"]],[null,2,[2104,1184],[null,null,"https://play-lh.googleusercontent.com/0cL8SNfgO5cBWXc1KJm6pwSggzHDTlsCUlWq2VQvmrxrMV5SCpyUk2aKyk9jL9-mlGUtxKoIrOd1aqCNS9nHgQ"]],[null,2,[2104,1184],[null,null,"https://play-lh.googleusercontent.com/VEobtDWIwHuA3IYzfEEPWnK83KPk2hMpF3MGaDW9eTVS-HJMnSTiZnehlsD49rxPHm6OdFc1zlpvQzwrdSbGyA"]],[null,2,[2104,1184],[null,null,"https://play-lh.googleusercontent.com/3tJJEdFpGKDuQiew3XNdOhtPRhjXEPEcpf5r_e9Hfr8DcvowULYZvpm6-s2hUV2-xj3xL4ZAt5o1AwuiRSFqUw"]],[null,2,[2104,1184],[null,null,"https://play-lh.googleusercontent.com/8pP6GpataT74D84uDyL35yJw3ksltqMBrMkBiXkbjKV1jrytzS_LGLYalPHiXQhQ0StJKEoC9pUWllP823xp2Q"]],[null,2,[2104,1184],[null,null,"https://play-lh.googleusercontent.com/xG8vp6AoPYQRckec9gqBSY1DgNdNz09HN-YaJagjyiWeastUfm20WnmIM_IffI7U1CFzY-VXOHox29dm-EAF"]],[null,2,[2104,1184],[null,null,"https://play-lh.googleusercontent.com/Yu2DYt-30Oxsrp8aI7fUyOyQg7uyknEBI92gHoOtIs132dRyg2CRAlux-FK4XCGrOmX5NGypnEmegwomrs_ncQ"]]],"Claude by Anthropic",["4,6",4.6396894],"Productivité",null,null,[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.anthropic.claude\u0026rdid\u003dcom.anthropic.claude\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.anthropic.claude"]],["qgJ8GnoIARIcChoKFGNvbS5hbnRocm9waWMuY2xhdWRlEAEYA0oTCJnRsbmkhZgDFUrhRAcd+bsTo5oBEwiZ0bG5pIWYAxVK4UQHHfm7E6P6ASwKDQgAEgkKBWZyLUZSEAASGxIECAIQARjO6Lqw54fHiH0g6/mhlqv+wNjEAQ\u003d\u003d"],null,[null,"Découvrez Claude, votre assistant personnel doté d’une intelligence artificielle qui réfléchit avec vous, et non à votre place.\u003cbr\u003e\u003cbr\u003eClaude, développé par Anthropic, est votre assistant virtuel tout-en-un doté d’une intelligence artificielle qui vous aide à coder, à rédiger du texte, à effectuer des recherches et à accomplir des tâches complexes en un rien de temps. Claude améliore votre productivité et votre efficacité.\u003cbr\u003e\u003cbr\u003eASSISTANT DE RÉDACTION DOTÉ D’UNE INTELLIGENCE ARTIFICIELLE\u003cbr\u003e\u003cbr\u003eUtilisez Claude comme assistant de rédaction pour transformer vos idées en contenus percutants. Que ce soit pour des emails professionnels, des rapports structurés ou des publications sur les réseaux sociaux, Claude affine votre style d’écriture, structure vos arguments et génère du texte de qualité professionnelle et d’une clarté irréprochable.\u003cbr\u003e\u003cbr\u003eTRADUCTION DANS PLUS DE 100 LANGUES\u003cbr\u003e\u003cbr\u003eClaude propose une traduction précise et naturelle optimisée par l’IA. Il traduit dans plus de 100 langues tout en préservant le sens, le contexte et le ton des conversations et des contenus textuels.\u003cbr\u003e\u003cbr\u003eAIDE AU CODAGE ET À LA PROGRAMMATION\u003cbr\u003e\u003cbr\u003eClaude est un assistant de codage polyvalent doté d’une intelligence artificielle, spécialement conçu pour les développeurs exigeants, et qui peut vous aider à écrire de simples scripts ou à déployer des logiciels d’entreprise. Cas d’utilisation : \u003cbr\u003e\u003cbr\u003e•        Relecture et correction de code\u003cbr\u003e•        Débogage précis et rapide\u003cbr\u003e•        Explication claire de concepts complexes\u003cbr\u003e•        Prise en charge de Python, JavaScript, React et des dizaines d’autres langages de programmation.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003eRECHERCHE ET ANALYSE\u003cbr\u003e\u003cbr\u003eNe perdez plus de temps à compiler vos données. Claude analyse vos documents et se connecte à vos outils quotidiens (Google Drive, Gmail, Agenda) pour extraire des informations exploitables en fournissant une liste de références.\u003cbr\u003e\u003cbr\u003eANALYSE VISUELLE\u003cbr\u003e\u003cbr\u003eImportez vos photos, PDF ou captures d’écran et Claude extrait le texte, interprète les tableaux et graphiques, analyse les interfaces, les diagrammes schématiques et les illustrations pour vous offrir une synthèse immédiate du contenu. Il peut même générer du code SVG pour graphiques et illustrations.\u003cbr\u003e\u003cbr\u003eCOMMANDE VOCALE - AUCUNE SAISIE DE TEXTE NÉCESSAIRE\u003cbr\u003e\u003cbr\u003eUtilisez Claude comme un assistant virtuel et confiez-lui des tâches à accomplir ou conversez avec lui pour entamer une séance de brainstorming.\u003cbr\u003e\u003cbr\u003eAPPRENTISSAGE ACCÉLÉRÉ\u003cbr\u003e\u003cbr\u003eClaude vous aide à développer vos connaissances et à acquérir de nouvelles compétences dans les divers domaines qui vous intéressent.\u003cbr\u003e\u003cbr\u003eClaude vous aide :\u003cbr\u003e\u003cbr\u003e▶ Rédiger et améliorer vos contenus textuels\u003cbr\u003e▶ Résumer vos réunions et extraire les informations clés\u003cbr\u003e▶ Générer des rapports et du contenu marketing\u003cbr\u003e▶ Résoudre des problèmes complexes avec des explications claires\u003cbr\u003e▶ Planifier des projets et structurer vos idées\u003cbr\u003e▶ Traduire dans plus de 100 langues en fournissant une traduction précise et naturelle\u003cbr\u003e▶ Extraire des informations de fichiers PDF et de contenus visuels\u003cbr\u003e▶ Travailler en mode mains libres grâce à la dictée\u003cbr\u003e▶ Coder et déboguer les programmes ainsi qu’à apprendre les divers langages de programmation\u003cbr\u003e▶ Générer des feuilles de calcul, graphiques et outils interactifs\u003cbr\u003e\u003cbr\u003eFIABLE ET DIGNE DE CONFIANCE\u003cbr\u003e\u003cbr\u003eClaude est conçu pour être précis, fiable et utile. Développé par Anthropic, une entreprise de recherche en IA dédiée à la création d’outils sûrs et responsables. Propulsé par Claude Opus et Claude Sonnet, il combine raisonnement avancé, créativité et performance.\u003cbr\u003e\u003cbr\u003eESSAYEZ CLAUDE GRATUITEMENT - ADOPTÉ PAR DES MILLIONS D’UTILISATEURS\u003cbr\u003e\u003cbr\u003eRejoignez des millions d’utilisateurs et commencez à utiliser Claude gratuitement. Que vous écriviez, codiez, recherchiez ou releviez des défis professionnels, Claude vous aide à repousser vos limites.\u003cbr\u003e\u003cbr\u003eConditions d’utilisation : https://www.anthropic.com/legal/consumer-terms\u003cbr\u003ePolitique de confidentialité : https://www.anthropic.com/legal/privacy\u003cbr\u003e\u003cbr\u003e© 2026 Anthropic, PBC"],"Anthropic PBC","50 000 000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/XhL9Sz2EUvup2XbszsARdLp5_-jDKw_4tIkG56dmlwkE_ELH_lXHDFgA0CTJ3k7RwSe1COy6-tcFRapYGPAv0w"],null,[240,238,229,255]],null,["Accord parental",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/VI5ii6OTeBuSn1kTDPlXSwj7yI7kqDqf_drsvZ90qjcm7LbbVkG8UfPTicKqMzipsY_lBnAYAH5t8GxN"]],[null,"Accord parental recommandé"],[null,"Achats in-app"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026amp;hl\u003dfr\"\u003eEn savoir plus\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/QMII6a27D3wNv5lBrfnnDgZK1DhX9XW8-ZaE68dzoNjMPdpnQLWzKhnznb7YzsO5bvTfntpj8i-q8M94"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026hl\u003dfr"]]],[[[[[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.anthropic.claude\u0026rdid\u003dcom.anthropic.claude\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]]],["Installer"],null,["CgYKBENBRT0\u003d"]]]],[2],[2],[1,1,0],["18,00 £GB - 225,00 £GB si facturé via Play",[0]],null,null,null,null,[2,1]],[["com.zhiliaoapp.musically",7],[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/2o7iuqPe-0msP3DvNhzoOgNo4eZ6GkL_RtGVeKyBn5UBQAW5cw-GW5V3wDOHB1yTQuqWzrFLFOv2u4_5ea1uhg"],null,[1,1,1,255],null,null,null,2],[[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/Bc1S4QexXhdRMB__Y6px97ILa3lJQyJ8dB67hKDn_ySxboxYpl9QY6fFD_ezerquqYQtjeyrKpySw0PawOZNog"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/9kZffZtGrwbC3RPAPDCbQzxh4Q6pTwPd4nd_yK-R1p2ZLriS-lfbbAtK1Dz2M3wb5zTzm3JXDk9_pftKYjlEOQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/ap8e1q0-RdMaoxxavAZ-oDdn8WD7_SklRzmigRJKFYedvAzlxCPEXOp8Ing8gU-JWri_f7WDf2GWRVFmlHHhWg"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/jgEryrZ5js4B2t2_hvZ5XYv3zrBkW9OO7wgsAIbvoydaL3qXG84B_-dM3xoJMeAvjh1k-zEf6Utzb7TdI-Rv9Q"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/2X_7pQAkhmvFR42SbY7Ors5DTpz3JRUvIoHbsxSnL_e_gTh74qur9-ifD9EqKO7qRMWvan25ZBETBHyIZOTp"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/B9Rt47hs9xO67xGSs9CtB_E89JYES3_XvwJqhAHy3r96CcVIf35ZHrT86Jg0SYFozrPFauR937WOyv6kA1I_xQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/Wu__RN5peEyTkcizFuQHPp0X33uhfo4Rnl1yfA5yH9Q2EYgdUjxAxT53piGiR5n5E1AAz0w-sx0U_obNOTTSQQ"]],[null,2,[1920,1080],[null,null,"https://play-lh.googleusercontent.com/cW19VCifDJRhEma98WqX6z4p9Jrhjx99hMva3ItJdfSKgqFmFrzZCbNfToo5xlHV-4BCepQaaRPOd8qH6yFFig"]]],"TikTok: Videos, Music \u0026 LIVE",["3,9",3.9218557],"Réseaux sociaux",null,null,[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.zhiliaoapp.musically\u0026rdid\u003dcom.zhiliaoapp.musically\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[[null,1]],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.zhiliaoapp.musically"]],["qgKIARqFAQgCEiAKHgoYY29tLnpoaWxpYW9hcHAubXVzaWNhbGx5EAEYA0oTCJnRsbmkhZgDFUrhRAcd+bsTo5oBEwiZ0bG5pIWYAxVK4UQHHfm7E6P6ATMKFQjkjbKGhfKjjEMSCQoFZW4tR0IQABIaEgQIAhABGLPj76nqo/K0VyC4pIqY452t6i4\u003d"],null,[null,"Discover videos, music and livestreams from around the world and create your own with easy-to-use tools to capture your life. \u003cbr\u003e\u003cbr\u003eFrom your morning coffee to your evening commute, TikTok has the videos to make your day. Whether you’re a sports fanatic, a travel lover or simply looking for a laugh, there’s something for everyone on TikTok. Looking to learn something new? Learn a new skill in 15 seconds across DIY, food recipes, and for animal lovers.\u003cbr\u003e\u003cbr\u003eEnjoy an endless stream of short videos on things you love most. Watch what you like and skip what you don’t.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eWATCH\u003c/b\u003e\u003cbr\u003eCreators on TikTok bring the best of content across the internet straight to your phone. \u003cbr\u003e\u003cbr\u003eA personalised video feed based on what you watch, like, and share. TikTok offers you real, interesting, and fun videos that will make your day.  You\u0026#39;ll find a variety of videos from Food and Fashion to Sports and Fitness - and everything in between. \u003cbr\u003e\u003cbr\u003e\u003cb\u003eCREATE\u003c/b\u003e\u003cbr\u003ePause and resume your video with just a tap. As many times as you need.\u003cbr\u003eMillions of creators on TikTok showcase their incredible skills and every day life. Let yourself be inspired. Discover all the tutorials \u003cbr\u003eUse effects and transitions to add final touches to your video before publishing it. \u003cbr\u003e \u003cbr\u003e\u003cb\u003eENTERTAIN\u003c/b\u003e\u003cbr\u003eBe entertained and inspired by a global community of creators.\u003cbr\u003eTake video creation to the next level with special effects, filters, music, and more. Unlock filters, effects, and AR objects to take your videos to the next level.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eCUSTOMISE\u003c/b\u003e\u003cbr\u003eOur integrated editing tools allow you to easily edit your videos.\u003cbr\u003eEditing tools to trim, cut, merge and duplicate video clips without leaving the app.\u003cbr\u003e \u003cbr\u003e\u003cb\u003eADD MUSIC\u003c/b\u003e\u003cbr\u003eAdd your favorite sound to your videos with millions of music clips and sounds. \u003cbr\u003eWe curate music and sound playlists for you with the hottest tracks in every genre, including Hip Hop, EM, Pop, Rock, Rap, and Country, and the most viral original sounds.\u003cbr\u003e\u003cbr\u003e■ Terms of Service\u003cbr\u003ehttps://www.tiktok.com/legal/terms-of-service\u003cbr\u003e\u003cbr\u003e■ Privacy Policy\u003cbr\u003ehttps://www.tiktok.com/legal/privacy-policy"],"TikTok Pte. Ltd.","1 000 000 000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/Wlh7xC-TMB9EOzQPy2VOlWHUN91xMbuS3xmqc30nBm_AzEYvgo9YlYFU9ufT1Ids8NMYM7nZhceLsnaUmv1w"],null,[253,253,253,255]],null,["Accord parental",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/VI5ii6OTeBuSn1kTDPlXSwj7yI7kqDqf_drsvZ90qjcm7LbbVkG8UfPTicKqMzipsY_lBnAYAH5t8GxN"]],[null,"Accord parental recommandé"],[null,"Interactivité des utilisateurs, Partage l\u0026#39;emplacement, Achats in-app"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026amp;hl\u003dfr\"\u003eEn savoir plus\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/QMII6a27D3wNv5lBrfnnDgZK1DhX9XW8-ZaE68dzoNjMPdpnQLWzKhnznb7YzsO5bvTfntpj8i-q8M94"]],[null,null,null,null,null,[null,null,"https://su