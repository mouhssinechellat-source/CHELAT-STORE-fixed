F_117pppK7bVyuRbRDYh0ha2Zw1kWn9wf-cCRZKNHROhcvdsWHsOjldmFNUysax4GG8ZJuclKwm3d2oSGl8PQ"]]],"Kimi",["4,2",4.2277226],"Outils",null,null,[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.moonshot.kimichat\u0026rdid\u003dcom.moonshot.kimichat\u0026feature\u003dmd\u0026offerId"]],null,["CAE\u003d"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,"/store/apps/details?id\u003dcom.moonshot.kimichat"]],["qgJgGl4IAxIdChsKFWNvbS5tb29uc2hvdC5raW1pY2hhdBABGANKEwiZ0bG5pIWYAxVK4UQHHfm7E6OaARMImdGxuaSFmAMVSuFEBx35uxOj+gEPCg0IABIJCgVmci1GUhAA"],null,[null,"# Fonctionnalités clés :\u003cbr\u003eKimi K3.1 Pro : des améliorations majeures en création 3D, en programmation, en création de contenu et en recherche financière.\u003cbr\u003eCréation de jeux 3D : donnez vie à vos idées avec le créateur de jeux Kimi. Décrivez votre idée et Kimi génère un jeu 3D multijoueur avec des personnages, des niveaux et un système de combat. Continuez à peaufiner le rendu visuel et le gameplay au fil de vos échanges avec Kimi.\u003cbr\u003eModélisation 3D : décrivez un objet, un bâtiment ou une scène par écrit, et Kimi en fait un modèle 3D détaillé. Affinez sa forme et son apparence au fil de vos échanges avec Kimi jusqu’à obtenir le résultat souhaité.\u003cbr\u003eAgent Swarm : mettez des systèmes multi-agents au travail sur des projets complexes. Kimi coordonne jusqu’à 300 agents IA sur 4 000 étapes en parallèle, réunissant recherche, analyse et rédaction de rapports dans un seul workflow.\u003cbr\u003eDiapositives IA : créez une présentation PowerPoint professionnelle à partir d’un simple sujet ou d’une référence visuelle. Kimi transforme vos idées en diapositives soignées, avec des mises en page dignes d’un designer, adaptées à votre travail et à vos études.\u003cbr\u003eOffice Agent : convertissez facilement vos fichiers : PDF vers Word, Word vers PDF, PDF vers Excel. Générez des formules Excel et transformez vos données en graphiques. Résumez et traduisez plusieurs fichiers, et ajoutez-y des commentaires.\u003cbr\u003eVibe Coding : décrivez le site web dont vous rêvez ou partagez une référence visuelle. Kimi affine la mise en page, les animations et les interactions au fil de vos échanges, et transforme votre idée en un site web fonctionnel avec du code de qualité professionnelle.\u003cbr\u003ePlugins : connectez-vous à des sources de données reconnues comme Wind et S\u0026amp;P. Analysez avec des données professionnelles fiables.\u003cbr\u003eContrôle à distance : contrôlez votre ordinateur depuis votre téléphone — reprenez vos tâches inachevées où que vous soyez.\u003cbr\u003eSynchronisation sur tous vos appareils : vos conversations, vos fichiers et l’avancement de votre travail restent synchronisés en temps réel sur tous vos appareils."],"Moonshot AI","5 000 000+",null,"",null,null,null,null,[null,2,[500,1024],[null,null,"https://play-lh.googleusercontent.com/2sNtObtWOnH71FGRk74YOhhae5NpWQKa-aByct2-m_DANfkg2av_Uj1iBpBbZx-VUfWNtRP8RVgsHgpMi874"],null,[151,157,159,255]],null,["Accord parental",[null,2,[512,512],[null,null,"https://play-lh.googleusercontent.com/VI5ii6OTeBuSn1kTDPlXSwj7yI7kqDqf_drsvZ90qjcm7LbbVkG8UfPTicKqMzipsY_lBnAYAH5t8GxN"]],[null,"Accord parental recommandé"],[null,"Interactivité des utilisateurs"],[null,"\u003ca href\u003d\"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026amp;hl\u003dfr\"\u003eEn savoir plus\u003c/a\u003e"],0,null,[null,2,[272,272],[null,null,"https://play-lh.googleusercontent.com/QMII6a27D3wNv5lBrfnnDgZK1DhX9XW8-ZaE68dzoNjMPdpnQLWzKhnznb7YzsO5bvTfntpj8i-q8M94"]],[null,null,null,null,null,[null,null,"https://support.google.com/googleplay?p\u003dappgame_ratings\u0026hl\u003dfr"]]],[[[[[null,[[0,"GBP",""]],null,[null,"Acheter"],null,1,[null,null,null,null,null,[null,null,"https://play.google.com/store/apps/details?id\u003dcom.moonshot.kimichat\u0026rdid\u003dcom.moonshot.kimichat\u0026feat