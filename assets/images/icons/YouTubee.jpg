24H0z" fill="none"/><path d="M0 0h24v24H0z" fill="none"/><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></span></span><span aria-hidden="true" jsname="fI6EEc" class="F7XJmb" data-number="5" ssk='1#5'><span class="notranslate Wi7KIe" aria-hidden='true'><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none"/><path d="M0 0h24v24H0z" fill="none"/><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></span></span></div><span class="bp9Aid">5 juin 2026</span></div></header><div class="h3YV2d">Depuis la dernière mise à jour du 28 mai 2026, lorsque l&#39;on enregistre une vidéo dans une playlist, c&#39;est devenu extrêmement difficile de déplacer la vidéo de position. Le problème c&#39;est qu&#39;on a du mal à bien sélectionner le bouton des deux barres qui sert à déplacer une vidéo. J&#39;ai du mal à comprendre si c&#39;est le bouton qui a rétréci ou si c&#39;est l&#39;image de la vidéo qui a été trop décalée sur le bouton de déplacement, mais mon expérience avec l&#39;interface utilisateur est horrible maintenant.</div><div jscontroller="SWD8cc" data-review-id="1b75ed1b-dcd7-4917-a1d3-8be128031a12" data-original-thumbs-up-count="22297"><div class="AJTPZc" jsname="J0d7Yd">22 297 personnes ont trouvé cet avis utile</div><footer class="Anb3we" jsname="GJNbDf" jsaction="sG2nqb:sY4eAb" soy-skip ssk='6:oOskHf'><div class="NC0Ppb">Ce contenu vous a-t-il été utile ?</div><div jsmodel="b7Ourf" jscontroller="wW2D8b" jsaction="rcuQ6b:BZEmlb;JIbuQc:TmtE8e" data-expanded-toggles=true><div class="b6SkTb"><div role="button" id="1b75ed1b-dcd7-4917-a1d3-8be128031a12::1" class="D3Qfie VfPpkd-ksKsZd-XxIAqe UQI9cd  kofMvc  EFMXQ" jscontroller="fdeHmf" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; touchstart:p6p2H; touchmove:FwuNnf; touchend:yfqBxc; touchcancel:JMtRjd; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;jzJ2q:RgMCxe" aria-label="Oui" tabindex="0" aria-pressed="false" data-single-select="true"><div class="Gggmbb" aria-hidden="true"></div><div class="kW9Bj" aria-hidden="true"><span class="c6xzBd jv2yne" jsname="o9vyuc"></span><span class="ypTNYd" jsname="ODzDMd">Oui</span></div></div><div role="button" id="1b75ed1b-dcd7-4917-a1d3-8be128031a12::2" class="D3Qfie VfPpkd-ksKsZd-XxIAqe UQI9cd  kofMvc  EFMXQ" jscontroller="fdeHmf" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; touchstart:p6p2H; touchmove:FwuNnf; touchend:yfqBxc; touchcancel:JMtRjd; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;jzJ2q:RgMCxe" aria-label="Non" tabindex="0" aria-pressed="false" data-single-select="true"><div class="Gggmbb" aria-hidden="true"></div><div class="kW9Bj" aria-hidden="true"><span class="c6xzBd jv2yne" jsname="o9vyuc"></span><span class="ypTNYd" jsname="ODzDMd">Non</span></div></div></div></div></footer></div></div><div jsaction="JIbuQc:trigger.hdtuG"><div class="u4ICaf"><div class="VfPpkd-dgl2Hf-ppHlrf-sM5MNb" data-is-touch-wrapper='true'><button class="VfPpkd-LgbsSe VfPpkd-LgbsSe-OWXEXe-dgl2Hf ksBjEc lKxP2d LQeN7 aLey0c" jscontroller="soHxf" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; touchstart:p6p2H; touchmove:FwuNnf; touchend:yfqBxc; touchcancel:JMtRjd; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;mlnRJb:fLiPzd;" data-disable-idom='true'><div class="VfPpkd-Jh9lGc"></div><div class="VfPpkd-J1Ukfc-LhBDec"></div><div class="VfPpkd-RLmnJb"></div><span jsname="V67aGc" class="VfPpkd-vQzf8d">Afficher tous les avis</span></button></div></div></div></div></div></section><c-data id="i17" jsdata=" MrvuD;_;38 fkWDob;com.google.android.youtube,7,,52;8 lxbR8d;_;11 ZR1Qoe;_;35 YjFXEf;_;36 WAAbQe;_;39 GU61mf;_;28"></c-data></c-wiz><c-wiz jsrenderer="JiSSTb" jsshadow jsdata="deferred-i22" data-p="%.@.null,null,true,&quot;com.google.android.youtube&quot;]" data-node-index="6;0" autoupdate jsmodel="hc6Ubd" c-wiz><div jscontroller="lpwuxb" jsaction="hdtuG:CnOdef"><section class="HcyOxe" jscontroller="NkbkFd" jsshadow><header class=" cswwxf"><div class="VMq4uf"><div class="EaMWib"><h2 class="XfZNbf">À propos de l&#39;application</h2></div><div jsaction="JIbuQc:trigger.hdtuG"><button class="VfPpkd-Bz112c-LgbsSe yHy1rc eT1oJ QDwDD mN1ivc VxpoF" jscontroller="soHxf" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; touchstart:p6p2H; touchmove:FwuNnf; touchend:yfqBxc; touchcancel:JMtRjd; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;mlnRJb:fLiPzd;" data-idom-class="yHy1rc eT1oJ QDwDD mN1ivc VxpoF" aria-label="Voir plus d&#39;infos sur &quot;À propos de l&#39;application&quot;"><div jsname="s3Eaab" class="VfPpkd-Bz112c-Jh9lGc"></div><div class="VfPpkd-Bz112c-J1Ukfc-LhBDec"></div><i class="google-material-icons notranslate VfPpkd-kBDsod W7A5Qb" aria-hidden='true'>arrow_forward</i></button></div></div></header><div class="SfzRHd" jsslot><meta itemprop="description" content="Regardez vos vidéos, chaînes et playlists préférées où que vous soyez."><div class="bARER" data-g-id="description" inert>Téléchargez l&#39;application YouTube officielle sur votre téléphone ou tablette Android. Découvrez les contenus regardés partout dans le monde : des clips musicaux du moment aux vidéos populaires sur les jeux vidéo, la mode, la beauté, les actualités, l&#39;éducation et bien plus encore. Abonnez-vous aux chaînes que vous aimez, créez vos propres vidéos, partagez des contenus avec vos amis et profitez de YouTube sur n&#39;importe quel appareil.<br><br>Regardez des vidéos et abonnez-vous à des chaînes <br>● Explorez les recommandations personnalisées dans &quot;Accueil&quot;.<br>● Découvrez les nouveautés de vos chaînes préférées dans &quot;Abonnements&quot;. <br>● Retrouvez les vidéos que vous avez regardées, aimées et enregistrées pour plus tard dans &quot;Bibliothèque&quot;. <br><br>Explorez des sujets variés, des contenus populaires et nos sélections à découvrir (disponibles dans certains pays)<br>● Ne manquez aucune vidéo populaire sur les jeux vidéo, la beauté, les actualités, l&#39;éducation et bien plus encore.<br>● Découvrez les tendances sur YouTube et à travers le monde dans &quot;Explorer&quot;.<br>● Parcourez nos sélections de créateurs, gamers et artistes à découvrir (disponibles dans certains pays).<br><br>Rejoignez la communauté YouTube<br>● Suivez vos créateurs favoris via les posts, les stories, les Premières et les diffusions en direct.<br>● Participez à la discussion dans les commentaires, et interagissez avec les créateurs et les autres membres de la communauté.<br><br>Créez des contenus sur votre appareil mobile<br>● Créez ou importez vos propres vidéos directement dans l&#39;application. <br>● Interagissez avec votre audience en temps réel avec le streaming en direct depuis l&#39;application.<br><br>Choisissez l&#39;expérience adaptée à vos besoins et ceux de votre famille (disponible dans certains pays)<br>● L’encadrement de l&#39;accès aux vidéos en ligne varie d&#39;une famille à l&#39;autre. Découvrez les options que nous vous proposons : l&#39;application YouTube Kids et la nouvelle expérience supervisée par les parents sur YouTube (youtube.com/myfamily).<br><br>Soutenez les créateurs que vous aimez avec les souscriptions aux chaînes (disponibles dans certains pays)<br>● Rejoignez les chaînes qui proposent une souscription mensuelle payante pour leur manifester votre soutien.<br>● Accédez aux avantages exclusifs offerts par des chaînes et devenez membre de leur communauté.<br>● Démarquez-vous des autres spectateurs dans les commentaires et le chat en direct grâce à l&#39;affichage d&#39;un badge de fidélité à côté de votre nom d&#39;utilisateur.<br><br>Passez à YouTube Premium (disponible dans certains pays)<br>● Regardez des vidéos sans publicité tout en utilisant d&#39;autres applications ou avec l&#39;écran verrouillé.<br>● Enregistrez des vidéos pour les regarder quand vous voulez, par exemple dans l&#39;avion ou les transports.<br>● Profitez de YouTube Music Premium dans le cadre de vos avantages.</div><div class="za5NB" role="note" aria-label="Regardez vos vidéos, chaînes et playlists préférées où que vous soyez.">Regardez vos vidéos, chaînes et playlists préférées où que vous soyez.</div><div class="TKjAsc"><div><div class="lXlx5">Date de mise à jour</div><div class="xg1aie">12 nov. 2026</div></div></div><div class="Uc6QCc"><div class="VfPpkd-dgl2Hf-ppHlrf-sM5MNb" data-is-touch-wrapper='true'><button class="VfPpkd-LgbsSe VfPpkd-LgbsSe-OWXEXe-INsAgc VfPpkd-LgbsSe-OWXEXe-dgl2Hf Rj2Mlf OLiIxf PDpWxe P62QJc LQeN7 LMoCf" jscontroller="soHxf" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; touchstart:p6p2H; touchmove:FwuNnf; touchend:yfqBxc; touchcancel:JMtRjd; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;mlnRJb:fLiPzd;" data-idom-class="Rj2Mlf OLiIxf PDpWxe P62QJc LQeN7 LMoCf" disabled><div class="VfPpkd-Jh9lGc"></div><div class="VfPpkd-J1Ukfc-LhBDec"></div><div class="VfPpkd-RLmnJb"></div><span jsname="V67aGc" class="VfPpkd-vQzf8d">#2 top des applications gratuites – lecteurs et éditeurs vidéo</span></button></div><div class="VfPpkd-dgl2Hf-ppHlrf-sM5MNb" data-is-touch-wrapper='true'><div class="VfPpkd-LgbsSe VfPpkd-LgbsSe-OWXEXe-INsAgc VfPpkd-LgbsSe-OWXEXe-dgl2Hf Rj2Mlf OLiIxf PDpWxe P62QJc LQeN7 LMoCf" jscontroller="nKuFpb" jsaction="click:cOuCgd; mousedown:UX7yZ; mouseup:lbsD7e; mouseenter:tfO1Yc; mouseleave:JywGue; touchstart:p6p2H; touchmove:FwuNnf; touchend:yfqBxc; touchcancel:JMtRjd; focus:AHmuwe; blur:O22p3e; contextmenu:mg9Pef;mlnRJb:fLiPzd;" data-idom-class="Rj2Mlf OLiIxf PDpWxe P62QJc LQeN7 LMoCf" itemprop="genre"><div class="VfPpkd-Jh9lGc"></div><span jsname="V67aGc" class="VfPpkd-vQzf8d" aria-hidden="true">Lecteurs et éditeurs vidéo</span><a class="WpHeLc VfPpkd-mRLv6 VfPpkd-RLmnJb" href="/store/apps/category/VIDEO_PLAYERS" aria-label="Lecteurs et é